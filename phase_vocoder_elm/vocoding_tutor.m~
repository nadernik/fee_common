sound(Singing,fs)

%% examine autocorrelation of dB trace
[c, lags] = xcorr(raw2dB(Singing,fs));
figure; 
plot(lags/fs, c');%./min([(1:numel(c)); numel(c) - (1:numel(c))],[],1));shg
lag = .228/3; %observed from autocorr for 73, purple37
%% separating the intros from the rest of the song (by eye)
intro_split = 1/fs;
INTROS = Singing(1:fs*intro_split);
SONG = Singing(fs*intro_split:end);
%% plot fft of autocorrelation
y = [diff(c); 0]; plot(lags/fs,y)
lag = 1/13; % estimated by graph
T = 1/fs;
L = length(y);
t = (0:L-1)*T;
NFFT = 2^nextpow2(L);
Y = fft(y,NFFT)/L;
f = fs/2*linspace(0,1,NFFT/2+1);
plot(f,2*abs(Y(1:NFFT/2+1))) 
title('Single-Sided Amplitude Spectrum of y(t)')
xlabel('Frequency (Hz)')
ylabel('|Y(f)|')
%% stretch a version
figure;  h = subplot(3,1,1); hold on
% set how many times faster and slower
faster_factor = lag/.05;
slower_factor = lag/.09; 
% plot original
displaySpecgramQuick([Singing],fs); hold on
steps = round(mod((1:numel([Singing]))/fs,lag)/lag);
plot((1:numel([Singing]))/fs,steps*6000/max(steps), 'r');
% plot faster one
g = subplot(3,1,2)
SpedUp = pvoc(Singing, faster_factor, 200);
displaySpecgramQuick([SpedUp],fs); hold on
% plot slower one
j = subplot(3,1,3)
SlowedDown = pvoc(Singing, slower_factor, 200); 
displaySpecgramQuick([SlowedDown],fs); hold on


linkaxes([h g j],'x')
xlim([0 max([numel(Singing)/fs numel(SlowedDown)/fs])])
